# Local evaluation storage (optional)
FRONTIER_DATA_DIR=.frontier
FRONTIER_DATABASE_PATH=.frontier/evaluations.sqlite3
FRONTIER_DASHBOARD_ORIGIN=http://localhost:3000

# Talon simulation/training records are deliberately isolated from Frontier model
# evaluation records. Both paths are local-only and may be deleted to reset Talon.
TALON_DATA_DIR=.frontier/talon
TALON_DATABASE_PATH=.frontier/talon/talon.sqlite3
# 0 disables automatic deletion. A positive value removes terminal Talon records
# and their local artifacts after that many days on API startup.
TALON_RETENTION_DAYS=0

# Hosted credentials are read only by the local API process. Copy this file to
# gitignored .env, or explicitly select "Save to local .env" in Settings.
# Precedence: session override, local .env, process environment, missing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional JSON object of server-side request headers; never sent to the browser.
OPENAI_EXTRA_HEADERS_JSON=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama needs no hosted API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
