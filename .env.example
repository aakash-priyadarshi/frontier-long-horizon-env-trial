# Local evaluation storage (optional)
FRONTIER_DATA_DIR=.frontier
FRONTIER_DATABASE_PATH=.frontier/evaluations.sqlite3
FRONTIER_DASHBOARD_ORIGIN=http://localhost:3000

# Hosted provider credentials are read only by the local API process.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional JSON object of server-side request headers; never sent to the browser.
OPENAI_EXTRA_HEADERS_JSON=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama needs no hosted API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
